# --- Postgres (used by docker-compose.yml) ---
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=jobtracker
POSTGRES_DB=jobtracker

# --- Backend ---
# Local docker-compose Postgres:
DATABASE_URL=postgresql+psycopg://jobtracker:jobtracker@localhost:5432/jobtracker
# Managed Postgres: convert postgresql:// or postgres:// → postgresql+psycopg://
# Example: postgresql+psycopg://user:pass@host:5432/db?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Session length when "Remember me" is checked on login
REMEMBER_ME_EXPIRE_DAYS=30
# Frontend origin used when building password-reset links
FRONTEND_BASE_URL=http://localhost:5173
# Local only: include a one-time reset URL in forgot-password responses (no email yet)
EXPOSE_DEV_RESET_LINK=true
# Set to true in production (HTTPS only)
COOKIE_SECURE=false
# lax = same-site (local / reverse-proxy). none = split hosting (requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
# Comma-separated exact origins (no trailing slash). Production: your Vercel/Netlify URL
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
SCRAPE_TIMEOUT_SECONDS=10
SCRAPE_MAX_BYTES=2097152

# --- Frontend ---
# Local Vite proxies /api to http://localhost:8000 — leave unset for development.
# Production (split hosting): absolute API origin, no trailing slash
# VITE_API_BASE_URL=https://your-api.example.com
